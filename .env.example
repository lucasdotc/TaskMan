# Copy this file to .env and fill in real values. .env is gitignored --
# never commit real secrets.

TELEGRAM_BOT_TOKEN=

# Comma-separated Telegram user IDs allowed to use the bot at all
# (admins and regular users both need to be listed here).
# Find your own ID with @userinfobot on Telegram, or by running /whoami
# once you're already on the allowed list.
ALLOWED_USER_ID=

# Comma-separated subset of ALLOWED_USER_ID who can run /transfer to send
# tasks to other users. Leave blank if you don't need admins yet.
ADMIN_USER_ID=

ANTHROPIC_API_KEY=

# Used only for voice message transcription (Claude doesn't accept audio).
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# If running via `docker compose up` (see docker-compose.yml), the host
# must be "postgres" -- that's the Compose service name, and containers on
# the same Compose network resolve each other by service name, not
# localhost. Running the bot directly on a host with its own Postgres
# install instead? Use localhost (or wherever Postgres actually is) here.
DATABASE_URL=postgresql://user:password@postgres/taskman_db

# Only used by docker-compose.yml to initialize the Postgres container --
# must match the user/password/db embedded in DATABASE_URL above. Not read
# by the bot itself, and not needed at all if you're not using Compose.
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=taskman_db

USER_TIMEZONE=America/Edmonton
